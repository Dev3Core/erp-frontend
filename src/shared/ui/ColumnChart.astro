---
// Single-series column chart, rendered on the server as SVG. One hue (the
// accent), no legend (the title names the series), per-column tooltip on
// hover and focus, and a table view so no value depends on hovering.

interface Point {
  key: string;
  label: string;
  value: number;
  display: string;
}

interface Props {
  id: string;
  title: string;
  points: Point[];
  formatTick: (n: number) => string;
}

const { id, title, points, formatTick } = Astro.props;

const W = 720;
const H = 240;
const PAD = { top: 12, right: 8, bottom: 28, left: 56 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

function niceMax(max: number) {
  if (max <= 0) return 1;
  const exp = 10 ** Math.floor(Math.log10(max));
  const f = max / exp;
  const step = f <= 1 ? 1 : f <= 2 ? 2 : f <= 2.5 ? 2.5 : f <= 5 ? 5 : 10;
  return step * exp;
}

const max = niceMax(Math.max(0, ...points.map((p) => p.value)));
const ticks = [0, 0.25, 0.5, 0.75, 1].map((t) => t * max);
const band = points.length ? plotW / points.length : plotW;
const barW = Math.max(2, Math.min(24, band - 2));
const y = (v: number) => PAD.top + plotH - (v / max) * plotH;
const labelEvery = Math.max(1, Math.ceil(points.length / 8));

// Column with a 4px rounded top, square at the baseline.
function columnPath(x: number, top: number, w: number) {
  const base = PAD.top + plotH;
  const h = base - top;
  if (h <= 0) return "";
  const r = Math.min(4, w / 2, h);
  return `M${x},${base}V${top + r}Q${x},${top} ${x + r},${top}H${x + w - r}Q${x + w},${top} ${x + w},${top + r}V${base}Z`;
}

const peak = points.reduce<Point | null>(
  (best, p) => (!best || p.value > best.value ? p : best),
  null,
);
const summary = peak
  ? `${title}. ${points.length} días. Máximo el ${peak.label}: ${peak.display}.`
  : `${title}. Sin datos.`;
---

<figure class="chart" data-chart={id}>
  <div class="plot">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={summary}>
      <g class="grid" aria-hidden="true">
        {ticks.map((t) => (
          <g>
            <line x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} />
            <text x={PAD.left - 8} y={y(t)} dy="0.32em" text-anchor="end">
              {formatTick(t)}
            </text>
          </g>
        ))}
      </g>
      <g class="bars">
        {points.map((p, i) => {
          const x = PAD.left + i * band + (band - barW) / 2;
          return (
            <g
              class="bar"
              tabindex="0"
              role="img"
              aria-label={`${p.label}: ${p.display}`}
              data-label={p.label}
              data-value={p.display}
            >
              <rect
                class="hit"
                x={PAD.left + i * band}
                y={PAD.top}
                width={band}
                height={plotH}
              />
              <path d={columnPath(x, y(p.value), barW)} />
            </g>
          );
        })}
      </g>
      <g class="axis" aria-hidden="true">
        {points.map((p, i) =>
          i % labelEvery === 0 ? (
            <text
              x={PAD.left + i * band + band / 2}
              y={H - 8}
              text-anchor="middle"
            >
              {p.label}
            </text>
          ) : null,
        )}
      </g>
    </svg>
    <div class="tooltip" role="presentation" hidden>
      <strong class="tt-value"></strong>
      <span class="tt-label"></span>
    </div>
  </div>

  <details class="table-view">
    <summary>Ver como tabla</summary>
    <div
      class="table-wrapper"
      tabindex="0"
      role="region"
      aria-label={`${title}, tabla`}
    >
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Día</th>
            <th scope="col" class="align-end">
              Valor
            </th>
          </tr>
        </thead>
        <tbody>
          {points.map((p) => (
            <tr>
              <th scope="row">{p.label}</th>
              <td class="align-end num" data-label="Valor">
                {p.display}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<script>
  for (const chart of document.querySelectorAll<HTMLElement>("[data-chart]")) {
    const plot = chart.querySelector<HTMLElement>(".plot")!;
    const tip = chart.querySelector<HTMLElement>(".tooltip")!;
    const value = tip.querySelector<HTMLElement>(".tt-value")!;
    const label = tip.querySelector<HTMLElement>(".tt-label")!;

    const show = (bar: SVGGElement) => {
      // Labels come from the API: textContent only.
      value.textContent = bar.dataset.value ?? "";
      label.textContent = bar.dataset.label ?? "";
      tip.hidden = false;
      const box = bar.querySelector("path")?.getBoundingClientRect();
      const host = plot.getBoundingClientRect();
      if (!box) return;
      const left = Math.min(
        Math.max(box.left + box.width / 2 - host.left, tip.offsetWidth / 2),
        host.width - tip.offsetWidth / 2,
      );
      tip.style.left = `${left}px`;
      tip.style.top = `${Math.max(0, box.top - host.top - tip.offsetHeight - 8)}px`;
    };
    const hide = () => (tip.hidden = true);

    for (const bar of chart.querySelectorAll<SVGGElement>(".bar")) {
      bar.addEventListener("pointerenter", () => show(bar));
      bar.addEventListener("focus", () => show(bar));
      bar.addEventListener("pointerleave", hide);
      bar.addEventListener("blur", hide);
    }
  }
</script>

<style>
  .chart {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .plot {
    position: relative;
  }
  svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }
  .grid line {
    stroke: var(--border);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  text {
    fill: var(--text-3);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .bar path {
    fill: var(--chart);
    transition: opacity 120ms;
  }
  .bar .hit {
    fill: transparent;
  }
  .bars:has(.bar:is(:hover, :focus-visible))
    .bar:not(:hover, :focus-visible)
    path {
    opacity: 0.45;
  }
  .bar:focus-visible {
    outline: none;
  }
  .bar:focus-visible .hit {
    stroke: var(--focus);
    stroke-width: 2;
  }
  .tooltip {
    position: absolute;
    translate: -50% 0;
    display: grid;
    gap: 0.125rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    font-size: 0.8125rem;
    white-space: nowrap;
    pointer-events: none;
  }
  .tooltip[hidden] {
    display: none;
  }
  .tt-value {
    font-variant-numeric: tabular-nums;
  }
  .tt-label {
    color: var(--text-2);
    font-size: 0.75rem;
  }
  .table-view summary {
    inline-size: fit-content;
    color: var(--accent);
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .table-view .table-wrapper {
    max-block-size: 16rem;
    margin-block-start: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  @media (forced-colors: active) {
    .bar path {
      fill: CanvasText;
    }
  }
</style>
