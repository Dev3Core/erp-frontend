---
import AppShell from "@/app/layouts/AppShell.astro";
import { isStaff } from "@/modules/identity";
import {
  DailyRevenuePanel,
  ModelKpis,
  PlatformSharePanel,
  StudioKpis,
  TopModelsPanel,
} from "@/modules/insights";
import { ShiftsPanel } from "@/modules/shifts";

const me = Astro.locals.me!;
const staff = isStaff(me.role);
const firstName = me.full_name.split(/\s+/)[0];
const lead = staff
  ? "Así va el estudio en los últimos 30 días."
  : me.role === "MODEL"
    ? "Tus resultados de los últimos 30 días."
    : "Tus turnos asignados.";
---

<AppShell title={`Hola, ${firstName}`} eyebrow="Resumen" lead={lead}>
  {staff && (
    <a
      slot="actions"
      class="btn btn-secondary"
      href="/app/liquidations?status=PENDING"
    >
      Revisar liquidaciones pendientes
    </a>
  )}

  {staff && <StudioKpis />}
  {me.role === "MODEL" && <ModelKpis />}

  {staff && (
    <div class="dashboard-grid">
      <DailyRevenuePanel />
      <div class="stack">
        <TopModelsPanel />
        <PlatformSharePanel />
      </div>
    </div>
  )}

  <ShiftsPanel
    compact
    title={me.role === "MONITOR" ? "Mis turnos" : "Turnos recientes"}
  />
</AppShell>

<style>
  .dashboard-grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (width >= 75rem) {
    .dashboard-grid {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-6);
    }
  }
  .stack {
    display: grid;
    gap: var(--space-5);
  }
</style>
