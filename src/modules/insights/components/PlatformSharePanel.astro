---
import { platformLabel } from "@/modules/studio";
import Notice from "@/shared/ui/Notice.astro";
import Panel from "@/shared/ui/Panel.astro";
import { formatUsd, toNumber } from "@/shared/lib/format";
import { getRevenueByPlatform } from "../queries";

const res = await getRevenueByPlatform(Astro.locals);
const total = res.ok
  ? res.data.items.reduce((s, p) => s + toNumber(p.total_usd), 0)
  : 0;
---

<Panel id="platform-title" title="Por plataforma">
  <div class="card-body">
    {res.ok ? (
      res.data.items.length ? (
        <ul class="shares">
          {res.data.items.map((p) => {
            const v = toNumber(p.total_usd);
            const pct = total ? Math.round((v / total) * 100) : 0;
            const name = platformLabel(p.platform);
            return (
              <li>
                <div class="share-head">
                  <span>{name}</span>
                  <span class="num">
                    {formatUsd(v)} <span class="muted">· {pct} %</span>
                  </span>
                </div>
                <meter
                  min="0"
                  max="100"
                  value={pct}
                  aria-label={`Participación de ${name}`}
                />
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="muted">Sin turnos en este periodo.</p>
      )
    ) : (
      <Notice message={res.message ?? ""} />
    )}
  </div>
</Panel>

<style>
  .shares {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .share-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.5rem;
  }
  meter {
    display: block;
    inline-size: 100%;
    block-size: 0.375rem;
    border: 0;
    border-radius: 999px;
    background: var(--surface-2);
    appearance: none;
  }
  meter::-webkit-meter-bar {
    border: 0;
    border-radius: 999px;
    background: var(--surface-2);
  }
  meter::-webkit-meter-optimum-value {
    border-radius: 999px;
    background: var(--accent);
  }
  meter::-moz-meter-bar {
    border-radius: 999px;
    background: var(--accent);
  }
</style>
