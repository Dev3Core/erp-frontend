---
import Notice from "@/shared/ui/Notice.astro";
import KpiCard from "@/shared/ui/KpiCard.astro";
import { formatCop, formatInt, formatUsd } from "@/shared/lib/format";
import { getOverview } from "../queries";

const overview = await getOverview(Astro.locals);
---

<section aria-labelledby="kpi-title">
  <h2 id="kpi-title" class="visually-hidden">
    Indicadores del estudio
  </h2>
  {overview.ok ? (
    <div class="kpi-grid">
      <KpiCard
        lead
        label="Ingresos · 30 días"
        value={formatUsd(overview.data.total_usd)}
        note={`${formatInt(overview.data.total_shifts)} turnos`}
      />
      <KpiCard label="Tokens" value={formatInt(overview.data.total_tokens)} />
      <KpiCard
        label="Pagado a modelos"
        value={formatCop(overview.data.total_cop_paid)}
        note={`${formatInt(overview.data.liquidations_paid)} liquidaciones pagadas`}
      />
      <KpiCard
        label="Por revisar"
        value={formatInt(overview.data.liquidations_pending)}
        note={`${formatInt(overview.data.liquidations_approved)} aprobadas sin pagar`}
      />
    </div>
  ) : (
    <Notice message={overview.message ?? ""} />
  )}
</section>
