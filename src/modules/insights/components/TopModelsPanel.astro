---
import Notice from "@/shared/ui/Notice.astro";
import Panel from "@/shared/ui/Panel.astro";
import { formatInt, formatUsd } from "@/shared/lib/format";
import { getTopModels } from "../queries";

const top = await getTopModels(Astro.locals);
---

<Panel
  id="top-title"
  title="Modelos destacadas"
  description="Por ingresos en el periodo"
>
  {top.ok ? (
    top.data.items.length ? (
      <ol class="ranking">
        {top.data.items.map((m, i) => (
          <li>
            <span class="rank num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="who">
              {m.full_name}
              <span class="cell-sub">{formatInt(m.total_shifts)} turnos</span>
            </span>
            <span class="amount num">{formatUsd(m.total_usd)}</span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="card-body muted">Sin turnos en este periodo.</p>
    )
  ) : (
    <div class="card-body">
      <Notice message={top.message ?? ""} />
    </div>
  )}
</Panel>

<style>
  .ranking {
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
  }
  .ranking li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.5rem;
    font-size: var(--text-sm);
  }
  .ranking li + li {
    border-block-start: var(--hairline) solid var(--border);
  }
  .rank {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.125rem;
  }
  .who {
    min-inline-size: 0;
    font-weight: 500;
  }
  .cell-sub {
    display: block;
    color: var(--text-3);
    font-size: var(--text-xs);
    font-weight: 400;
  }
  .amount {
    font-weight: 500;
  }
</style>
